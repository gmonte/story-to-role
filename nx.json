{
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/configs/**/*",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/tsconfig*.json"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.{ts,tsx}",
      "!{projectRoot}/**/*.md",
      "!{projectRoot}/vitest.*.ts",
      "!{projectRoot}/src/test/**/*"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": [
        "{projectRoot}/.next",
        "!{projectRoot}/.next/cache",
        "{projectRoot}/.vercel",
        "{projectRoot}/build",
        "{projectRoot}/dist"
      ]
    },
    "predeploy": {
      "cache": true,
      "dependsOn": ["^predeploy"]
    },
    "lint": {
      "cache": true,
      "dependsOn": ["typecheck", "^lint"],
      "inputs": ["default", "^production"]
    },
    "lint:fix": {
      "cache": true,
      "dependsOn": ["typecheck", "^lint:fix"],
      "inputs": ["default", "^production"]
    },
    "test": {
      "cache": true,
      "dependsOn": ["typecheck"],
      "inputs": ["default", "^production"]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^typecheck"],
      "inputs": ["default", "^production"]
    }
  },
  "analytics": false,
  "nxCloudId": "6af853f1af7ceb84ecb53afe"
}
