{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts",
    "./*/index": "./src/*/index.ts",
    "./eslint.config": "./eslint.config.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "db:up": "pnpm db:generate && pnpm db:migrate",
    "db:generate": "SKIP_ENV_VALIDATION=1 drizzle-kit generate",
    "db:migrate": "DB_MIGRATING=true drizzle-kit migrate",
    "db:push": "DB_MIGRATING=true drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint . --max-warnings=0 --no-warn-ignored",
    "lint:fix": "eslint . --fix",
    "predeploy": "pnpm db:migrate",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "trigger:dev": "trigger dev",
    "trigger:deploy": "trigger deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:ai",
    "@clerk/nextjs": "catalog:web",
    "@repo/common": "workspace:*",
    "@repo/intl": "workspace:*",
    "@trigger.dev/sdk": "catalog:api",
    "@trpc/server": "catalog:common",
    "@upstash/ratelimit": "catalog:api",
    "@upstash/redis": "catalog:api",
    "@vercel/blob": "catalog:api",
    "drizzle-orm": "catalog:api",
    "drizzle-zod": "catalog:api",
    "postgres": "catalog:api",
    "superjson": "catalog:common",
    "trpc-to-openapi": "catalog:web",
    "tsx": "catalog:common",
    "zod": "catalog:common"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:testing",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@trigger.dev/build": "catalog:api",
    "@types/node": "catalog:common",
    "@vitest/coverage-v8": "catalog:testing",
    "drizzle-kit": "catalog:api",
    "trigger.dev": "catalog:api",
    "type-fest": "catalog:common",
    "vitest": "catalog:testing"
  }
}
