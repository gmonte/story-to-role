{
  "extends": "@repo/typescript-config/library.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@repo/api/*": ["./src/*"],
      "@repo/common/*": ["../common/src/*"],
      "@repo/intl/*": ["../intl/src/*"]
    }
  },
  "include": [
    "src",
    "drizzle.config.ts",
    "@types/*.d.ts",
    "vitest.*.ts",
    "trigger.config.ts"
  ]
}
