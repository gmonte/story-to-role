{
  "name": "@repo/common",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts",
    "./*/index": "./src/*/index.ts",
    "./eslint.config": "./eslint.config.js"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0 --no-warn-ignored",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "catalog:web",
    "zod": "catalog:common"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:common",
    "@vitest/coverage-v8": "catalog:testing",
    "type-fest": "catalog:common",
    "vitest": "catalog:testing"
  }
}
